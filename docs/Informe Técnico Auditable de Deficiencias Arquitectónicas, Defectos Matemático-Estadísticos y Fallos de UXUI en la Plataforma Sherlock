def apply_calibration(
raw_prob: float,
market_family: str,
market_side: str | None = None,
odds: float | None = None,
league_id: str | None = None,
) -> float:
"""Aplica la curva de calibración jerárquica activa sin heurísticas manuales.

    Elimina completamente exponentes empíricos y penalizaciones por cuota (>2.0, >3.0).
    Devuelve la inferencia directa del artefacto o raw_prob como fallback.
    """
    # Garantizar que la probabilidad de entrada esté acotada en [0.0, 100.0]
    prob_clamped = max(0.0, min(100.0, float(raw_prob)))

    try:
        # Intentar obtener el calibrador jerárquico activo desde data/calibration/active.json
        calibrator = get_calibrator()
        if calibrator is not None and hasattr(calibrator, "predict_probability"):
            calibrated = calibrator.predict_probability(
                raw_prob=prob_clamped,
                market_family=market_family,
                market_side=market_side,
                league_id=league_id,
            )
            return round(max(0.0, min(100.0, float(calibrated))), 2)
    except Exception:
        # Ante cualquier fallo de inferencia o ausencia de artefacto, fallar de forma limpia
        pass

    # Fallback estricto sin distorsiones heurísticas
    return round(prob_clamped, 2)

