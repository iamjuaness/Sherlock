def \_compute_league_reliability_score(league: LeagueStats) -> float:
"""Calcula el Score de Fiabilidad de Liga (LRS) combinando volumen de partidos,

    calidad de los datos de la competición y ajuste por desempeño histórico.

    Respetando la especificacion tecnica de la Tarea 1:
    - Base LRS en [0.15, 0.85] basada en partidos históricos e integridad de datos.
    - Ajuste por desempeño A_perf en [-0.10, +0.10] activado UNICAMENTE si historical_picks >= 50.
    - Resultado acotado deterministamente en [0.15, 1.00].
    """
    matches = getattr(league, "historical_matches", 0) or 0

    # 1. Componente de Volumen de Partidos: Sigmoide acotada en [0.0, 0.50]
    # S_matches = 0.50 / (1 + exp(-(matches - 150) / 50))
    exponent = -float(matches - 150) / 50.0
    # Limitar exponente para prevenir overflow en math.exp
    exponent_clamped = max(-50.0, min(50.0, exponent))
    s_matches = 0.50 / (1.0 + math.exp(exponent_clamped))

    # 2. Componente de Integridad de Datos de la Liga en [0.0, 0.35]
    # Evalua la presencia de métricas no nulas en la competición
    data_integrity_score = getattr(league, "data_integrity_score", 0.70) or 0.70
    s_integrity = max(0.0, min(0.35, float(data_integrity_score) * 0.35))

    # LRS Base acotado en el rango [0.15, 0.85]
    lrs_base = max(0.15, min(0.85, s_matches + s_integrity))

    # 3. Ajuste por Desempeño Histórico A_perf en [-0.10, +0.10]
    # Condición estricta: Solo se activa si historical_picks >= 50
    historical_picks = getattr(league, "historical_picks", 0) or 0
    historical_roi = getattr(league, "historical_roi", 0.0) or 0.0

    if historical_picks >= 50:
        a_perf = max(-0.10, min(0.10, 0.5 * float(historical_roi)))
    else:
        a_perf = 0.0

    # Formula Final LRS acotada en [0.15, 1.00]
    lrs_final = max(0.15, min(1.00, lrs_base + a_perf))
    return round(lrs_final, 4)

