def estimate_empirical_bayes_prior_n(
league_variance: float,
league_mean: float,
team_matches: int,
data_quality_score: float | None = None,
baseline_prior_n: float = 6.0,
min_prior_n: float = 2.0,
max_prior_n: float = 14.0,
) -> float:
"""Estima dinámicamente el valor de prior_n para el Shrinkage Bayesiano basándose en

    la dispersión de la liga (Factor de Fano), la calidad de datos y el tamaño de muestra.

    Fórmula: prior_n = baseline_prior_n * F * DQ_adj * N_adj
    Acotado deterministamente en [min_prior_n, max_prior_n].
    """
    # 1. Índice de Dispersión / Factor de Fano: F = var / max(mean, 0.1)
    safe_mean = max(float(league_mean), 0.1)
    fano_factor = float(league_variance) / safe_mean
    # Acotar razonablemente el factor de Fano para evitar explosiones
    fano_factor_clamped = max(0.5, min(2.0, fano_factor))

    # 2. Factor de Calidad de Datos DQ_adj en [0.8, 1.4]
    dq = 70.0 if data_quality_score is None else float(data_quality_score)
    dq_clamped = max(0.0, min(100.0, dq))
    dq_adj = 1.0 + (1.0 - (dq_clamped / 100.0)) * 0.4

    # 3. Factor de Muestra de Partidos del Equipo N_adj en [0.8, 1.3]
    safe_matches = max(int(team_matches), 1)
    n_adj = max(0.8, min(1.3, 10.0 / float(safe_matches)))

    # Cálculo final de prior_n dinámico
    raw_prior_n = float(baseline_prior_n) * fano_factor_clamped * dq_adj * n_adj
    prior_n_final = max(float(min_prior_n), min(float(max_prior_n), raw_prior_n))

    return round(prior_n_final, 2)

