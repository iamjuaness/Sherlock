def get_data_quality_score(
selection: str,
h: FootballTeamStats,
a: FootballTeamStats,
use_general_stats: bool = False,
) -> float:
"""Calcula el Score de Calidad de Datos mediante una suma ponderada lineal (0 a 100 pts).

    Descomposición:
    - Datos xG/xGA (25 pts): 25 si ambos disponen de xG/xGA reales, 12.5 si solo uno.
    - Conteo y Presión (35 pts): Shots (15 pts), Corners (10 pts), Tarjetas/Faltas (10 pts).
    - Muestra Local/Visita (25 pts): min(matches_home, matches_away) >= 5 -> 25 pts, 2-4 -> 15 pts, <2 -> 5 pts.
      (Si use_general_stats es True, evalua la muestra total de partidos).
    - Contexto y Forma (15 pts): Disponibilidad de Posesion, Ratings o Forma Reciente.
    """
    if h is None or a is None:
        return 0.0

    score = 0.0

    # 1. Cobertura de xG / xGA (25.0 pts)
    h_xg = (getattr(h, "xg_per_game", 0.0) or 0.0) > 0 and (getattr(h, "xga_per_game", 0.0) or 0.0) > 0
    a_xg = (getattr(a, "xg_per_game", 0.0) or 0.0) > 0 and (getattr(a, "xga_per_game", 0.0) or 0.0) > 0

    if h_xg and a_xg:
        score += 25.0
    elif h_xg or a_xg:
        score += 12.5

    # 2. Métricas de Conteo y Presión (35.0 pts)
    # Tiros y Tiros a puerta (15 pts)
    h_shots = (getattr(h, "shots_per_game", 0.0) or 0.0) > 0
    a_shots = (getattr(a, "shots_per_game", 0.0) or 0.0) > 0
    if h_shots and a_shots:
        score += 15.0

    # Córners (10 pts)
    h_corners = (getattr(h, "corners_per_game", 0.0) or 0.0) > 0
    a_corners = (getattr(a, "corners_per_game", 0.0) or 0.0) > 0
    if h_corners and a_corners:
        score += 10.0

    # Disciplina: Tarjetas y Faltas (10 pts)
    h_cards = (getattr(h, "yellow_cards_per_game", 0.0) or 0.0) > 0
    a_cards = (getattr(a, "yellow_cards_per_game", 0.0) or 0.0) > 0
    if h_cards and a_cards:
        score += 10.0

    # 3. Muestra y Segmentación (25.0 pts)
    if use_general_stats:
        h_m = getattr(h, "matches_total", 0) or 0
        a_m = getattr(a, "matches_total", 0) or 0
        min_matches = min(h_m, a_m)
    else:
        h_m = getattr(h, "matches_home", 0) or 0
        a_m = getattr(a, "matches_away", 0) or 0
        min_matches = min(h_m, a_m)

    if min_matches >= 5:
        score += 25.0
    elif min_matches >= 2:
        score += 15.0
    else:
        score += 5.0

    # 4. Métricas Secundarias / Contexto y Forma (15.0 pts)
    h_pos = (getattr(h, "possession_pct", 0.0) or 0.0) > 0
    a_pos = (getattr(a, "possession_pct", 0.0) or 0.0) > 0
    h_form = bool(getattr(h, "recent_form", None))
    a_form = bool(getattr(a, "recent_form", None))

    if h_pos and a_pos:
        score += 10.0
    if h_form and a_form:
        score += 5.0

    return round(max(0.0, min(100.0, score)), 1)

