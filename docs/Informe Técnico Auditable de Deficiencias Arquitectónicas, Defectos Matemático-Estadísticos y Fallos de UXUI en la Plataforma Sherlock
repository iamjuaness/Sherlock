def \_calculate_stake_units(v: ValueIndicator) -> float:
"""Calcula las unidades de stake asignadas a la apuesta utilizando el Criterio de Kelly

    Fraccional continuado y acotado estrictamente a un máximo de 3.0 unidades (3% de banca).

    Reglas de Sizing:
    - Banca de referencia: 100 unidades.
    - Escalamiento continuo en [0.25, 3.00] unidades para edge_ev >= 0.020.
    - Devuelve 0.0u si edge_ev < 0.020.
    """
    if v is None or v.edge_ev is None or v.edge_ev < 0.020:
        return 0.0

    if v.implied_prob is None or v.implied_prob <= 0:
        return 0.0

    odds = 100.0 / v.implied_prob
    if odds <= 1.0:
        return 0.0

    # 1. Calculo de Kelly Bernoulli crudo: f* = (p*b - q) / b = edge_ev / (odds - 1)
    b = odds - 1.0
    p = float(v.calibrated_prob) / 100.0
    q = 1.0 - p
    raw_kelly = (p * b - q) / b

    if raw_kelly <= 0:
        return 0.0

    # 2. Aplicar Fracción de Kelly conservadora (1/4 de Kelly)
    fractional_kelly = raw_kelly / 4.0

    # 3. Escalar a Banca de 100 unidades y ponderar por Score LRS de Liga
    lrs = getattr(v, "league_reliability_score", 0.85) or 0.85
    raw_stake = fractional_kelly * 100.0 * float(lrs)

    # 4. Acotación continua en el rango [0.25, 3.00] unidades
    clamped_stake = max(0.25, min(3.00, raw_stake))

    # Redondear a 2 decimales para garantizar precisión financiera
    return round(clamped_stake, 2)

