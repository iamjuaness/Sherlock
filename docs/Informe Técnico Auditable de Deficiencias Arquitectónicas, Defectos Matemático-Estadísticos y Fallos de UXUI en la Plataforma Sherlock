def is_publishable_pick(v: ValueIndicator) -> bool:
"""Determina si un pick cumple con los estándares para ser clasificado como Profesional.

    Requisitos refactorizados:
    - Cuota en el rango [1.30, 2.80].
    - Expected Value estricto: edge_ev >= 0.020 (EV >= 2.0%).
    - Probabilidad Calibrada Mínima:
      * Standard/Binary (goals, btts, double_chance): calibrated_prob >= 50.0%
      * High Volatility (result, corners, cards, shots): calibrated_prob >= 25.0%
    - Stake asignado: stake_units > 0.0.
    """
    if v is None or v.fair_odds is None or v.fair_odds <= 0:
        return False

    # Derivar cuota decimal implícita si no viene directa
    odds = 100.0 / v.implied_prob if (v.implied_prob and v.implied_prob > 0) else 0.0
    if not (1.30 <= odds <= 2.80):
        return False

    # Verificar piso estricto de Valor Esperado
    if v.edge_ev is None or v.edge_ev < 0.020:
        return False

    # Clasificación por familia de mercado
    market_family = getattr(v, "market_family", "goals") or "goals"
    high_volatility_markets = {"result", "corners", "cards", "shots", "shots_on_target", "fouls"}

    if market_family in high_volatility_markets:
        if v.calibrated_prob < 25.0:
            return False
    else:
        if v.calibrated_prob < 50.0:
            return False

    # Verificar existencia de stake positivo
    if v.stake_units is None or v.stake_units <= 0.0:
        return False

    return True

def is_underdog_pick(v: ValueIndicator) -> bool:
"""Determina si un pick cumple con los requisitos de la categoría Underdog.

    Requisitos refactorizados:
    - Cuota en el rango (2.50, 8.00].
    - Expected Value estricto: edge_ev >= 0.050 (EV >= 5.0%).
    - Data Quality Score >= 50.0.
    - Stake mínimo fraccionado: stake_units >= 0.25.
    """
    if v is None or v.implied_prob is None or v.implied_prob <= 0:
        return False

    odds = 100.0 / v.implied_prob
    if not (2.50 < odds <= 8.00):
        return False

    if v.edge_ev is None or v.edge_ev < 0.050:
        return False

    if v.data_quality_score is None or v.data_quality_score < 50.0:
        return False

    if v.stake_units is None or v.stake_units < 0.25:
        return False

    return True

